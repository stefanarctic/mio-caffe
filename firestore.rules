rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: content
    // Document ID: hero
    // Fields:
    //   - primary: map { url: string, path: string, fileId: string, alt: string }
    //   - secondary: map { url: string, path: string, fileId: string, alt: string }
    //   - updatedAt: timestamp (optional)
    //
    // Document ID: gallery
    // Fields:
    //   - photos: list of { id, url, path, fileId, caption, order }
    //   - updatedAt: timestamp (optional)
    //
    // Document ID: featured
    // Fields:
    //   - items: list of { id, name, category, vol, price, desc, url, path, fileId, alt, order }
    //   - updatedAt: timestamp (optional)
    //
    // Document ID: menuPhotos
    // Fields:
    //   - items: map keyed by menu item slug -> { url, path, fileId }
    //   - updatedAt: timestamp (optional)
    //
    // Image binaries are stored in ImageKit, not Firestore. These documents
    // only keep public image URLs and ImageKit file IDs.
    //
    // Public read is required: the cafe website shows these photos to
    // unauthenticated visitors on the landing page and menu.
    // Writes are limited to the allowlisted admin Google/email account.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email == 'neuroweb01@gmail.com';
    }

    function isValidUrl(url) {
      return url is string
        && url.size() > 11
        && url.size() <= 2000
        && (url.matches('^https://.*') || url.matches('^http://.*'));
    }

    function isValidImageRef(data) {
      return data is map
        && data.keys().hasOnly(['url', 'path', 'fileId', 'alt'])
        && isValidUrl(data.url)
        && data.path is string && data.path.size() <= 500
        && data.fileId is string && data.fileId.size() <= 200
        && data.alt is string && data.alt.size() <= 120;
    }

    function isValidMenuImage(data) {
      return data is map
        && data.keys().hasOnly(['url', 'path', 'fileId'])
        && isValidUrl(data.url)
        && data.path is string && data.path.size() <= 500
        && data.fileId is string && data.fileId.size() <= 200;
    }

    function isValidGalleryPhoto(data) {
      return data is map
        && data.keys().hasOnly(['id', 'url', 'path', 'fileId', 'caption', 'order'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 80
        && isValidUrl(data.url)
        && data.path is string && data.path.size() <= 500
        && data.fileId is string && data.fileId.size() <= 200
        && data.caption is string && data.caption.size() <= 80
        && data.order is int && data.order >= 0 && data.order <= 100;
    }

    function isValidFeaturedItem(data) {
      return data is map
        && data.keys().hasOnly(['id', 'name', 'category', 'vol', 'price', 'desc', 'url', 'path', 'fileId', 'alt', 'order'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 80
        && data.name is string && data.name.size() > 0 && data.name.size() <= 80
        && data.category is string && data.category.size() <= 40
        && data.vol is string && data.vol.size() <= 40
        && data.price is string && data.price.size() > 0 && data.price.size() <= 40
        && data.desc is string && data.desc.size() <= 400
        && isValidUrl(data.url)
        && data.path is string && data.path.size() <= 500
        && data.fileId is string && data.fileId.size() <= 200
        && data.alt is string && data.alt.size() <= 120
        && data.order is int && data.order >= 0 && data.order <= 20;
    }

    function isValidHero(data) {
      return data.keys().hasOnly(['primary', 'secondary', 'updatedAt'])
        && isValidImageRef(data.primary)
        && isValidImageRef(data.secondary)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidPhotoList(list) {
      return list is list
        && list.size() <= 40
        && (list.size() == 0 || isValidGalleryPhoto(list[0]))
        && (list.size() < 2 || isValidGalleryPhoto(list[1]))
        && (list.size() < 3 || isValidGalleryPhoto(list[2]))
        && (list.size() < 4 || isValidGalleryPhoto(list[3]))
        && (list.size() < 5 || isValidGalleryPhoto(list[4]))
        && (list.size() < 6 || isValidGalleryPhoto(list[5]))
        && (list.size() < 7 || isValidGalleryPhoto(list[6]))
        && (list.size() < 8 || isValidGalleryPhoto(list[7]))
        && (list.size() < 9 || isValidGalleryPhoto(list[8]))
        && (list.size() < 10 || isValidGalleryPhoto(list[9]))
        && (list.size() < 11 || isValidGalleryPhoto(list[10]))
        && (list.size() < 12 || isValidGalleryPhoto(list[11]));
    }

    function isValidFeaturedList(list) {
      return list is list
        && list.size() > 0
        && list.size() <= 6
        && isValidFeaturedItem(list[0])
        && (list.size() < 2 || isValidFeaturedItem(list[1]))
        && (list.size() < 3 || isValidFeaturedItem(list[2]))
        && (list.size() < 4 || isValidFeaturedItem(list[3]))
        && (list.size() < 5 || isValidFeaturedItem(list[4]))
        && (list.size() < 6 || isValidFeaturedItem(list[5]));
    }

    function isValidGallery(data) {
      return data.keys().hasOnly(['photos', 'updatedAt'])
        && isValidPhotoList(data.photos)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidFeatured(data) {
      return data.keys().hasOnly(['items', 'updatedAt'])
        && isValidFeaturedList(data.items)
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidMenuPhotos(data) {
      return data.keys().hasOnly(['items', 'updatedAt'])
        && data.items is map
        && data.items.size() <= 200
        && (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    match /content/{docId} {
      allow read: if true;

      allow create, update: if isAdmin()
        && (
          (docId == 'hero' && isValidHero(request.resource.data))
          || (docId == 'gallery' && isValidGallery(request.resource.data))
          || (docId == 'featured' && isValidFeatured(request.resource.data))
          || (docId == 'menuPhotos' && isValidMenuPhotos(request.resource.data))
        );

      allow delete: if false;
    }
  }
}
